# Deployment
NGINX_PORT=8088
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=manus

# API
ENV=production
LOG_LEVEL=INFO
APP_CONFIG_FILEPATH=config.yaml
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:change_me@manus-postgres:5432/manus
REDIS_HOST=manus-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Tencent Cloud COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# Sandbox
SANDBOX_ADDRESS=manus-sandbox
SANDBOX_IMAGE=manus-sandbox
SANDBOX_NAME_PREFIX=mooc-manus-sandbox
SANDBOX_TTL_MINUTES=60
SANDBOX_NETWORK=manus-network
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=
